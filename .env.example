# Copy this file to .env and fill in real values. Never commit .env.

# Random string used to sign login cookies (generate one in stage 7)
SECRET_KEY=change-me

# The shared family password (stage 7)
FAMILY_PASSWORD=change-me

# Anthropic API key (stage 5) – get it from console.anthropic.com
ANTHROPIC_API_KEY=

# Database location (default: local SQLite file)
DATABASE_URL=sqlite:///hormonious.db
