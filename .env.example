# Copy this file to .env and fill in real values. Never commit .env.

# Random string that signs the login cookie. Make one with: python manage.py make-secret
SECRET_KEY=change-me

# The shared family password. Leave as change-me on your PC to skip logging in locally.
FAMILY_PASSWORD=change-me

# Anthropic API key (stage 5) – get it from console.anthropic.com
ANTHROPIC_API_KEY=

# Database location. Leave blank for hormonious.db in the project folder.
DATABASE_URL=
